# dashboard-web — Phase 1A environment variables. NO real credentials in
# this file, ever. Copy to .env.local (gitignored) and fill in locally.
# dashboard-web never holds integration credentials at all (ADR-0002) —
# this file will never grow database/API-key-shaped variables.

NODE_ENV=development
LOG_LEVEL=info

# Phase 1C — dashboard-api's own origin, used by every /auth/* page
# (apps/dashboard-web/lib/auth.ts) to build sign-in/logout/API request
# URLs. Must be set for the auth pages to work at all in local dev.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

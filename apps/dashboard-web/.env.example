# dashboard-web — Phase 1A environment variables. NO real credentials in
# this file, ever. Copy to .env.local (gitignored) and fill in locally.
# dashboard-web never holds integration credentials at all (ADR-0002) —
# this file will never grow database/API-key-shaped variables.

NODE_ENV=development
LOG_LEVEL=info

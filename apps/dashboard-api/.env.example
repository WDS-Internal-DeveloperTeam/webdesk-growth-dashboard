# dashboard-api — Phase 1A environment variables. NO real credentials in
# this file, ever — it is committed to git specifically because it MUST
# stay free of real secrets. Copy to .env (gitignored) and fill in locally.
# Integration credentials (database, GitHub App, Google Workspace, SMTP,
# Blob, queues) are added here only once their owning integration is
# actually authorized and implemented — see docs/project-state/setup-input-register.md.

NODE_ENV=development
LOG_LEVEL=info
PORT=3001

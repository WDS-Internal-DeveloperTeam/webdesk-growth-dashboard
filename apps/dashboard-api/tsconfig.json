{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist",
    "rootDir": "src",
    "isolatedModules": false,
    "esModuleInterop": true,
    "allowJs": true,
    "incremental": true
  },
  "include": ["src"]
}

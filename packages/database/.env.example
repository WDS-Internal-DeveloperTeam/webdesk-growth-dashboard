# packages/database — Phase 1B environment variables. NO real credentials in
# this file, ever — it is committed to git specifically because it MUST
# stay free of real secrets. Copy to .env.local (gitignored) and fill in
# locally. This is the ONLY package that ever reads a database credential
# (ADR-0006, WDS-011) — no other app/package should ever need these.
# See README.md for local setup instructions.

DATABASE_URL=postgres://user:password@localhost:5432/webdesk_phase1b_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=2
DATABASE_POOL_MIN=0
DATABASE_POOL_IDLE_MS=10000
DATABASE_POOL_ACQUIRE_MS=30000
